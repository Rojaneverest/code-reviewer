# Environment Variables Template for Local GitLab Runner
# Copy this file to .env.runner (for Docker) or configure in /etc/gitlab-runner/env/ai-reviewer.env

# Database Configuration (Supabase)
host=db.your-project.supabase.co
port=5432
dbname=postgres
user=postgres
password=your_supabase_password

# Databricks LLM Configuration
DATABRICKS_TOKEN=your_databricks_token
DATABRICKS_BASE_URL=https://dbc-3735add4-1cb6.cloud.databricks.com
DATABRICKS_ENDPOINT=/serving-endpoints/databricks-claude-sonnet-4/invocations
DATABRICKS_MODEL_NAME=databricks-claude-sonnet-4
DATABRICKS_TIMEOUT=60

# GitLab API Configuration
GITLAB_API_TOKEN=your_gitlab_personal_access_token

# Optional: LM Studio Configuration for local development/fallback
ENABLE_LM_STUDIO_FALLBACK=false
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_TIMEOUT=60
